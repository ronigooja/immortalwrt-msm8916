#!/bin/sh

LOGGER_TAG="usb-role-autodetect"
DEVICE_WAIT="${USB_DEVICE_WAIT:-12}"
BOARD_LEDS="red:power green:wlan blue:wan"

log() {
	logger -t "$LOGGER_TAG" "$*"
}

prepare_led() {
	local led
	led="$1"

	[ -w "/sys/class/leds/$led/trigger" ] && {
		echo none > "/sys/class/leds/$led/trigger" 2>/dev/null || true
	}
}

set_led() {
	local led brightness
	led="$1"
	brightness="$2"

	[ -w "/sys/class/leds/$led/brightness" ] || return 0
	prepare_led "$led"
	echo "$brightness" > "/sys/class/leds/$led/brightness" 2>/dev/null || true
}

set_board_leds_off() {
	local led

	for led in $BOARD_LEDS; do
		set_led "$led" 0
	done
}

set_usb_device_led() {
	set_board_leds_off
	set_led "green:wlan" 1
}

find_role_node() {
	local node

	for node in \
		/sys/class/usb_role/*/role \
		/sys/kernel/debug/ci_hdrc.*/role \
		/sys/kernel/debug/*ci_hdrc*/role
	do
		[ -e "$node" ] || continue
		[ -w "$node" ] || continue
		echo "$node"
		return 0
	done

	return 1
}

set_role() {
	local role="$1"

	{ echo "$role" > "$ROLE_NODE"; } 2>/dev/null || {
		log "failed to switch USB role to $role via $ROLE_NODE"
		return 1
	}

	log "switched USB role to $role via $ROLE_NODE"
	return 0
}

device_connected() {
	local state carrier

	for state in /sys/class/udc/*/state; do
		[ -r "$state" ] || continue
		case "$(cat "$state" 2>/dev/null)" in
			configured|connected)
				return 0
				;;
		esac
	done

	for carrier in /sys/class/net/usb*/carrier; do
		[ -r "$carrier" ] || continue
		[ "$(cat "$carrier" 2>/dev/null)" = "1" ] && return 0
	done

	return 1
}

wait_for_device() {
	local i=0

	while [ "$i" -lt "$DEVICE_WAIT" ]; do
		device_connected && return 0
		sleep 1
		i=$((i + 1))
	done

	return 1
}

bring_up_usb_wan() {
	local i=0

	while [ "$i" -lt 20 ]; do
		[ -e /sys/class/net/eth0 ] && break
		sleep 1
		i=$((i + 1))
	done

	[ -e /sys/class/net/eth0 ] || {
		log "eth0 not found after USB host switch, skip WAN bring-up"
		return 0
	}

	if command -v ethtool >/dev/null 2>&1; then
		log "eth0 found after USB host switch, applying USB-RJ45 offload settings"
		ethtool -K eth0 rx-udp-gro-forwarding on rx-gro-list off 2>/dev/null || true
	fi

	log "bringing up WAN after USB host switch"
	ifup wan 2>/dev/null || true
	ifup wan6 2>/dev/null || true
}

ROLE_NODE="$(find_role_node)" || {
	set_board_leds_off
	log "no writable USB role node found"
	exit 0
}

set_board_leds_off

if ! set_role device; then
	set_board_leds_off
	exit 0
fi

if wait_for_device; then
	set_usb_device_led
	log "USB device mode is active, keeping connection to computer"
	exit 0
fi

log "no computer detected after ${DEVICE_WAIT}s, switching to USB host for RJ45"
set_board_leds_off
set_role host && bring_up_usb_wan
